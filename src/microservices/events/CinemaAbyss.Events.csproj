<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Events service: an MVP that checks how Kafka fits the CinemaAbyss
    architecture. The API produces User/Payment/Movie events to Kafka and the
    same service consumes them back and records them in its log.

    The Docker build context is this folder (fixed by docker-compose.yml and the
    CI workflow), so the project is self-contained: build settings and package
    versions live here rather than in a solution-level Directory.*.props that the
    image build could not reach.

    One project per service. The layers are folders, and the dependency rule
    (Presentation -> Infrastructure -> Application -> Domain) is a convention
    here rather than something the compiler enforces.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CinemaAbyss.Events</RootNamespace>
    <AssemblyName>CinemaAbyss.Events</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Kafka client; unlike a bus abstraction it exposes the partition
         and offset of each produced message, which the API returns. -->
    <PackageReference Include="Confluent.Kafka" Version="2.15.1" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.12" />
    <PackageReference Include="Scalar.AspNetCore" Version="2.17.8" />
  </ItemGroup>

  <!-- Container settings for the IDE tooling: the image is always a Linux one. -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

</Project>
