<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Strangler Fig proxy (API Gateway) in front of the Go monolith and the
    extracted microservices.

    The Docker build context is this folder (fixed by docker-compose.yml and the
    CI workflow), so the project is self-contained: build settings and package
    versions live here rather than in a solution-level Directory.*.props that the
    image build could not reach.

    One project per service. The layers are folders, and the dependency rule
    (Presentation -> Infrastructure -> Domain) is a convention here rather than
    something the compiler enforces.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>CinemaAbyss.Proxy</RootNamespace>
    <AssemblyName>CinemaAbyss.Proxy</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <!-- Container settings for the IDE tooling: the image is always a Linux one. -->
  <PropertyGroup>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>.</DockerfileContext>
  </PropertyGroup>

</Project>
